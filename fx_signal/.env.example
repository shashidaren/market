# fx_signal — copy this file to .env and fill in real values
# Real values: keep them in your password manager, NEVER commit them.

# Telegram bot for FX signal alerts (get token from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Signal engine mode
SIGNAL_MODE=strict

# Minimum confidence % to deliver (default 60). Today's 55% EURJPY would be filtered.
# MIN_CONFIDENCE=60

# Finnhub API key for economic calendar (https://finnhub.io)
FINNHUB_API_KEY=your-finnhub-api-key-here

# Position sizing (shown in the Telegram message)
# ACCOUNT_BALANCE=100        # account size in ACCOUNT_CURRENCY
# ACCOUNT_CURRENCY=USD       # your account currency
# RISK_PER_TRADE_PCT=1.0     # % of account risked per trade (SL distance)

# Yahoo rate-limit tuning (optional; safe defaults)
# FX_COLLECTOR_SLEEP=0.5     # seconds between per-symbol fetches
# FX_BATCH_FETCH=0           # 1 = fetch all *stale* symbols per timeframe
#                            #     in one parallel yf.download() call
# FX_FORCE_FETCH=0           # 1 = ignore skip-if-fresh (always hit Yahoo)
# FX_EMPTY_STREAK_TRIPS=3    # consecutive empty replies that trip the circuit
# YAHOO_COOLDOWN_SECS=900    # how long the box-wide circuit stays open
# YAHOO_CIRCUIT_PATH=/tmp/market-yahoo-circuit.json
#                            # inspect/reset: python3 /opt/market/yahoo_client.py
#                            #                python3 /opt/market/yahoo_client.py --reset
