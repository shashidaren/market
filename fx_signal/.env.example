# fx_signal — copy this file to .env and fill in real values
# Real values: keep them in your password manager, NEVER commit them.

# Telegram bot for FX signal alerts (get token from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Signal engine mode
SIGNAL_MODE=strict

# Finnhub API key for economic calendar (https://finnhub.io)
FINNHUB_API_KEY=your-finnhub-api-key-here

# Position sizing (shown in the Telegram message)
# ACCOUNT_BALANCE=100        # account size in ACCOUNT_CURRENCY
# ACCOUNT_CURRENCY=USD       # your account currency
# RISK_PER_TRADE_PCT=1.0     # % of account risked per trade (SL distance)
