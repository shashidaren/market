# announcements_signal — copy this file to .env and fill in real values
# Real values: keep them in your password manager, NEVER commit them.

# Telegram bot for Bursa insider-trade alerts (get token from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here

# Reduce Telegram noise: only actionable i_report decisions are delivered.
IREPORT_FILTER=on
# Keep off (safe default): defer alerts when i_report/Yahoo is unavailable.
# Set on only if you intentionally want fail-open delivery during outages.
IREPORT_FAIL_OPEN=off
TELEGRAM_CHAT_ID=your-chat-id-here
