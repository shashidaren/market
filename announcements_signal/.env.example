# announcements_signal — copy this file to .env and fill in real values
# Real values: keep them in your password manager, NEVER commit them.

# Telegram bot for Bursa insider-trade alerts (get token from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# --- Announcements collector resilience (defaults are safe) -----------------
# Page-1 attempts per run (including the first try). Fresh cloudscraper each try.
RETRY_MAX=5
# Total API requests per run, and shared rolling hourly cap across cron runs.
# Old ceiling was 18/hour; default 20 is the hard maximum (+2 margin).
ANNOUNCEMENTS_MAX_REQUESTS=5
ANNOUNCEMENTS_HOURLY_MAX_REQUESTS=20
# Randomised pause between page-1 retries, seconds.
ANNOUNCEMENTS_JITTER_MIN=1
ANNOUNCEMENTS_JITTER_MAX=3
ANNOUNCEMENTS_TIMEOUT=30
# Heartbeat older than this many minutes => preflight FAIL.
ANNOUNCEMENTS_STALE_MINUTES=60
# Extra Bursa holidays / ad-hoc closures, comma-separated YYYY-MM-DD.
# Shipped calendar: bursa_holidays.json (verify annually).
BURSA_HOLIDAYS=
# Full tracebacks for collector failures (still log-capped).
DEBUG=0

# --- Optional browser challenge solver (OFF by default) ---------------------
# Requires: pip install selenium, plus matching Chromium and chromedriver.
# Leave 0 unless measured cloudscraper success is poor; see README.md.
ANNOUNCEMENTS_BROWSER_SOLVER=0
ANNOUNCEMENTS_BROWSER_TIMEOUT=45
# Optional explicit binary paths if not on PATH:
# CHROMIUM_BINARY=/usr/bin/chromium
# CHROMEDRIVER_BINARY=/usr/bin/chromedriver
