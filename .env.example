# =============================================================================
# /opt/market/.env  —  SINGLE SOURCE OF TRUTH for all secrets & runtime knobs
# =============================================================================
# Copy this file on the server:
#   cp /opt/market/.env.example /opt/market/.env
#   chmod 600 /opt/market/.env
#   $EDITOR /opt/market/.env
#
# Never commit the real .env. Module-local .env files are optional migration
# leftovers; prefer putting everything here.
# =============================================================================

# --- Telegram (shared across fx / indices / announcements) --------------------
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# --- Finnhub (FX economic news / calendar proxy) -----------------------------
# https://finnhub.io — free tier is enough for /news?category=forex
FINNHUB_API_KEY=your-finnhub-api-key-here

# --- FX signal engine --------------------------------------------------------
SIGNAL_MODE=strict
# MIN_CONFIDENCE=60

# Position sizing shown in Telegram messages (optional)
# ACCOUNT_BALANCE=100
# ACCOUNT_CURRENCY=USD
# RISK_PER_TRADE_PCT=1.0

# --- Yahoo rate-limit tuning (optional; safe defaults in code) ---------------
# yahoo_client.py shares ONE circuit breaker between every Yahoo job on this
# box (fx, indices, announcements price-context, movers tab): any rate-limit
# reply — or FX_EMPTY_STREAK_TRIPS empty replies in a row — pauses ALL of
# them for YAHOO_COOLDOWN_SECS via the state file YAHOO_CIRCUIT_PATH.
# FX_COLLECTOR_SLEEP=0.5
# FX_BATCH_FETCH=0
# FX_EMPTY_STREAK_TRIPS=3
# YAHOO_COOLDOWN_SECS=900
# YAHOO_CIRCUIT_PATH=/tmp/market-yahoo-circuit.json

# --- Dashboard "movers" tab (insider_movers.py; optional) --------------------
# Price cache per stock. Also pauses ALL movers fetches for YAHOO_COOLDOWN_SECS
# after a Yahoo rate-limit reply.
# MOVERS_PRICE_TTL=600            # seconds, during Bursa hours
# MOVERS_PRICE_TTL_OFFHOURS=3600  # seconds, nights / weekends

# --- Dashboard "top" tab (top_mover.py; the single highest-probability name) --
# Universe = insider-active stocks + stocks in recently scored headlines.
# TOP_MOVER_SHORTLIST=12          # stocks priced per refresh (3-24); each one is
#                                 # one more Yahoo request per TTL
# TOP_MOVER_INSIDER_DAYS=10       # insider filing window
# TOP_MOVER_NEWS_DAYS=2           # headline window
# TOP_MOVER_THRESHOLD_PCT=3.0     # the "big move" the probability refers to

# --- Autosync (autosync.sh + deploy/market-autosync.timer) -------------------
# The timer runs every 5 minutes and syncs BOTH ways:
#   commit server edits -> fetch -> rebase -> push
# AUTOSYNC_BRANCH=main            # branch the server tracks
# AUTOSYNC_REMOTE=origin
# AUTOSYNC_NET_TIMEOUT=120        # seconds per network operation
# AUTOSYNC_MERGE=1                # merge instead of rebase when diverged

# --- Announcements / i_report ------------------------------------------------
# IREPORT_FILTER=on
